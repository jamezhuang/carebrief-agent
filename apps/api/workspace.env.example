# Append to existing .env. Reuse your existing RAG_DATABASE_URL and model keys.
WORKSPACE_ENABLED=true
# Optional administrator accounts. They must already be registered using your own passwords.
WORKSPACE_ADMIN_EMAILS=
# Optional absolute local private-file directory. Default: apps/api/.cache/private_uploads
# WORKSPACE_UPLOAD_DIR=/app/.cache/private_uploads
# Include the chosen frontend port. Use one hostname consistently for cookies.
CORS_ORIGINS=http://127.0.0.1:3100,http://localhost:3100,http://127.0.0.1:3000,http://localhost:3000
