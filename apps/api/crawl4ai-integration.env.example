# 合并到 apps/api/.env，同名配置只保留一行，不要覆盖已有密钥。
CRAWL4AI_ENABLED=true
CRAWL4AI_BROWSER=msedge
# 相对于 apps/api；使用你已经安装好的独立环境。
CRAWL4AI_PYTHON=.venv-crawl/Scripts/python.exe

# 已有的这些配置请检查/修改现有行，不要重复追加。
PROVIDER_MODE=live
EXTERNAL_SEARCH_ENABLED=true
WEB_DOMESTIC_ONLY=true
WEB_SEARCH_PROVIDER=bocha

# 精确主机列表：只对这里的 HTTP URL 保留 HTTP，不进行全站协议降级。
WEB_HTTP_ALLOWED_HOSTS=pnhqyy.com,www.pnhqyy.com
# 示例人工登记站点。已有 WEB_VERIFIED_DOMAINS 时，在其原值末尾追加 ,pnhqyy.com。
# registered 表示运维登记，不表示政府认证，也不证明医院等级或医学疗效。
WEB_VERIFIED_DOMAINS=pnhqyy.com
