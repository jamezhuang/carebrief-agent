# CareBrief API configuration example. Copy to apps/api/.env.
# Generated from source fields; private credential values are never copied.
# Fill the chat and embedding API keys before using live mode.
# Optional web search keys are needed only for the enabled search service.
# Docker Compose overrides RAG_DATABASE_URL, DATABASE_URL and key storage paths.
# The local RAG URL below is a placeholder; replace CHANGE_ME for native development.
# Do not change commented fields unless you understand their code defaults.
# Core Docker image does not include browser rendering or OCR dependencies.

# CORE
CORS_ORIGINS=http://127.0.0.1:3100,http://localhost:3100
CRAWL4AI_ENABLED=false
DATABASE_URL=sqlite:///.cache/carebrief.db
PROVIDER_MODE=live
RAG_DATABASE_URL=postgresql+psycopg://carebrief:CHANGE_ME@127.0.0.1:5433/carebrief_rag

# MODELS
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DISABLE_THINKING=true
DEEPSEEK_MODEL=deepseek-flash
EMBEDDING_DIMENSIONS=1024
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RAG_RERANK_ENABLED=true
RAG_RERANK_TIMEOUT_SECONDS=30
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1

# SEARCH
BOCHA_API_KEY=
BOCHA_SEARCH_URL=https://api.bochaai.com/v1/web-search
# CRAWL4AI_BROWSER=  # Keep application default; configure explicitly if needed
# CRAWL4AI_PYTHON=  # Keep application default; configure explicitly if needed
# EXTERNAL_DOMAINS=  # Optional; keep application default
EXTERNAL_DOMAIN_FILTER_ENABLED=true
EXTERNAL_SEARCH_ENABLED=true
TAVILY_API_KEY=
WEB_BROWSER_MAX_READS=5
WEB_DOMESTIC_ONLY=false
# WEB_HTTP_ALLOWED_HOSTS=  # Optional; keep application default
WEB_PUBLIC_READ_ENABLED=true
WEB_SEARCH_PROVIDER=bocha
WEB_VERIFIED_DOMAINS=fshtcm.com.cn,sdrmyy.com,fsccyy.com

# WORKSPACE
HEALTH_MEMORY_ENABLED=true
# WORKSPACE_ADMIN_EMAILS=  # Keep application default; configure explicitly if needed
WORKSPACE_ENABLED=true
# WORKSPACE_UPLOAD_DIR=  # Keep application default; configure explicitly if needed

# CONTEXT
CONTEXT_COMPACTION_ENABLED=true
# CONTEXT_SUMMARY_DB=  # Keep application default; configure explicitly if needed
CONTEXT_SUMMARY_TIMEOUT=20
HISTORY_MAX_CHARS=6000
HISTORY_MAX_TURNS=6

# OTHER
# AGENT_DIAGNOSTICS_DIR=  # Keep application default; configure explicitly if needed
AGENT_DIAGNOSTICS_ENABLED=false
AGENT_RELIABILITY_ENABLED=true
AGENT_RELIABILITY_V2_ENABLED=true
AGENT_RELIABILITY_V3_ENABLED=true
API_TIMEOUT_SECONDS=30
COOKIE_SECURE=false
DEV_TOKEN=
OCR_ENABLED=false
RAG_BACKEND=postgres
RAG_CHUNK_OVERLAP=80
RAG_CHUNK_SIZE=600
RAG_HYBRID_CANDIDATES=10
RAG_MIN_SCORE=0.2
# RAG_POSTGRES_PASSWORD=  # Only for standalone compose.rag.yml
RAG_QUERY_PLANNING_ENABLED=true
RAG_SEARCH_MODE=hybrid
RETRIEVAL_MIN_SCORE=0.2
